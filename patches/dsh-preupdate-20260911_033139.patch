+-      this.waiting = undefined
+-      this.queue.length = 0
+-      this.cancellation.abort(reason)
+-      waiting?.resolve({ value: undefined, done: true })
+-    }
+-    // Whether cancelled or left after the producer settled, the consumer pulls nothing more: drop what it left.
+-    this.queue.length = 0
+-    this.wakeDrained()
+-  }
