+-  }, { discrete: true })
+-  const click = (key: string, detail = 1) => {
+-    const target = editor.getElementByKey(key)!
+-    target.dispatchEvent(new MouseEvent('click', { bubbles: true, detail }))
+-  }
+-  return { editor, root, chip, text, open, click, off }
+-}
