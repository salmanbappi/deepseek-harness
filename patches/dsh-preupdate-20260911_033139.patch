+-/** A scratch installation: an anchor package, bundles under its node_modules, plugin packages beside them. */
+-class Scratch {
+-  readonly root = mkdtempSync(join(tmpdir(), 'bundle-roster-'))
+-  readonly anchor = join(this.root, 'app', 'package.json')
