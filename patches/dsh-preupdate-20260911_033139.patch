+-/** Run `fn` inside React `act` when a DOM exists; plain await otherwise. */
+-async function settle(fn: () => Promise<void>): Promise<void> {
+-  if (typeof document === 'undefined') {
+-    await fn()
+-    return
+-  }
+-  await act(async () => { await fn() })
+-}
