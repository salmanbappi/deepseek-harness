+-const test = createClientTest({ roster: webApp }, { mount: true })
+-test('registers into the sidebar', async ({ remote, start }) => {
+-  remote.settings.describe.mockResolvedValue(ok({ writable: true, hasDocument: false, namespaces: [] }))
