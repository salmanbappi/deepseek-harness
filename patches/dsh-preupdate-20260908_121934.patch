+-     * nothing and the chip shows the registry's `title(address)` text captured
+-     * at open time.
+-     */
+-    'sidebar.right.pane.tab.title': {
+-      kind: 'keyed'
+-      scope: 'session'
+-      hookContext: TabHookContext
+-      inject: SidebarRightTabInjected
+-    }
