+-  const root = new URL(rootUrl).pathname.replace(/\/+$/, '')
+-  const target = new URL(targetUrl).pathname
+-  if (target === root) return ''
+-  return target.slice(root.length + 1).split('/').map(decodeURIComponent).join('/')
+-}
