+-    moveFloat: (paneId, x, y) => { actions.moveFloat(sessionId, paneId, x, y) },
+-    resizeFloat: (paneId, rect) => { actions.resizeFloat(sessionId, paneId, rect) },
+-    resizeSplit: (splitId, sizes) => { actions.resizeSplit(sessionId, splitId, sizes) },
