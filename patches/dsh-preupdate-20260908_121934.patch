+-  const snapshot = controller.getSnapshot()
+-  return render(
+-    <DockSurface
+-      {...options}
+-      state={snapshot.state}
+-      canSplit={canSplit}
+-      intents={intents}
+-      labels={TEST_LABELS}
+-      renderTab={tab => <p data-testid="body">{tab.contentId}</p>}
+-      {...renderTabMenuItems === undefined ? {} : { renderTabMenuItems }}
+-    />,
+-  )
+-}
