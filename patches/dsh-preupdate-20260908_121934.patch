++}
++
++function storeFor(
++  current: Awaited<ReturnType<typeof createBench>>,
++  slot: 'conversation.view' | 'details',
++  sessionId: SessionId,
++): ChatInstance {
++  return current.runtime.storeOf(slot, sessionId) as ChatInstance
++}
