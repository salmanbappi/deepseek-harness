+-
+-  /** Follow one Activation to natural settlement. */
+-  private watchSettlement(activation: Activation): void {
+-    void (async () => {
+-      while (true) {
+-        const idleObservation = activation.poke
+-        await activation.handle.agent.whenIdle()
