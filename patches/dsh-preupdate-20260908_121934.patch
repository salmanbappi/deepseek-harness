+-/** Render the docked surface over a controller's current layout. */
+-function renderSurface(
+-  controller: DockController,
+-  intents: DockIntents,
+-  canSplit = true,
+-  renderTabMenuItems?: TabMenuExtras,
+-  options: Pick<DockSurfaceProps, 'dropZones' | 'minPaneFraction'> = {},
