+-  if (min <= 0) return SPLIT_MINIMUMS.chip
+-  if (style.boxSizing === 'border-box') return min
+-  return min + px(style.paddingLeft) + px(style.paddingRight) + px(style.borderLeftWidth) + px(style.borderRightWidth)
+-}
