+-    launches.push([command, ...args])
+-    return Promise.resolve()
+-  }
+-  internals.catalog = {
+-    platform: 'darwin',
+-    applicationRoots: [join(home, 'Applications')],
+-    run,
+-    launch,
+-    resolveExecutable: pathTable(),
+-  }
+-}
