+-export function measurePaneFits(root: HTMLElement): ReadonlyMap<PaneId, HalvesFit> {
+-  const minimums: SplitMinimums = { divider: dividerSize(root), chip: chipMinimum(root), body: SPLIT_MINIMUMS.body }
