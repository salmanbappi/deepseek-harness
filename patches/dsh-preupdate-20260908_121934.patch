+-    const b = controller.openContent({ contentId: 'dsh-resource://file/session/s/b.txt', title: 'b.txt', kind: 'file' })
+-    const seed = getPane(controller.getSnapshot().state, controller.getSnapshot().state.rootId).tabs[0]
