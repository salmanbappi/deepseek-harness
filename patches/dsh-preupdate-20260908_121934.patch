+-describe('launchDetachedApp', () => {
+-  const node = process.execPath
+-
+-  it('resolves when the child exits 0 inside the watch window', async () => {
+-    await expect(launchDetachedApp(node, ['-e', ''], { watchMs: TIMEOUT_MS }))
+-      .resolves.toBeUndefined()
