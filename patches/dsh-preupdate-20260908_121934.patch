+-    useOpenInAppApps: useSelector(apps),
+-    useOpenInAppChoice: useSelector(choice),
+-    launch,
+-    choose,
+-    iconUrl: (appId: string) => `/open-in-app/icon/${appId}`,
+-    t,
+-  } as unknown as OpenInAppActionProps
