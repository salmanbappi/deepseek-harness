+-          type="button"
+-          className={clsx(css.tool, state.wrap && css.toolOn)}
+-          aria-pressed={state.wrap}
+-          aria-label={t('wrap')}
+-          title={t('wrap')}
+-          data-textpreview-tool="wrap"
+-          onClick={() => { actions.toggledWrap(tab.id) }}
+-        >
+-          <IconWrapOutline16 />
+-        </button>
+-        <button
+-          type="button"
+-          className={css.tool}
+-          aria-label={t('reload')}
+-          title={t('reload')}
+-          data-textpreview-tool="reload"
+-          onClick={reload}
+-        >
+-          <IconRefreshOutline16 />
+-        </button>
+-      </div>
+-      <div
