+-          </p>
+-        )
+-        : meta.value?.changed === true && (
+-          <p className={css.changed} data-textpreview-changed>
+-            <span>{t('changed')}</span>
+-            <button
+-              type="button"
+-              className={css.action}
+-              data-textpreview-reload-now
+-              onClick={reload}
+-            >
+-              {t('reloadNow')}
+-            </button>
+-          </p>
+-        )}
