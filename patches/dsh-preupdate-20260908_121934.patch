+-  }
+-
+-  /**
+-   * The pane a new tab lands in, for an embedder that needs to name it.
+-   * @returns the active pane when docked, else the first docked pane.
+-   */
+-  activeDockPaneId(): PaneId {
+-    return dockedActivePane(this.state)
+-  }
+-}
