+-import { WorkspaceChangeFeed } from './changes.ts'
+-import type {
+-  WorkspaceByteRange,
+-  WorkspaceDirectoryEntry,
+-  WorkspaceDirectoryListing,
+-  WorkspaceFileBytes,
+-  WorkspaceFileRange,
+-  WorkspaceFileStat,
+-  WorkspaceFileText,
