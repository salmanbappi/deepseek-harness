+-  it('honours an embedder\'s twenty-percent minimum', () => {
+-    expect(clampSizes([0.01, 0.99], 0.2)).toEqual([0.2, 0.8])
+-    expect(clampSizes([0.99, 0.01], 0.2)).toEqual([0.8, 0.2])
+-    expect(clampSizes([0.5, 0.5], 0.2)).toEqual([0.5, 0.5])
