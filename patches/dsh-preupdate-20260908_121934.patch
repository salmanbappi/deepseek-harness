++                            {rawResultText(material.block)}
++                          </pre>
++                        )
++                        : <div className={css.empty}>{t('details.running')}</div>,
++                    })}
++                  </Fragment>
++                </section>
++              </>
++            )}
++      </div>
++    </div>
