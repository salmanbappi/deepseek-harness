+-    expect(zoneSplit('right')).toEqual({ axis: 'row', direction: 'after' })
+-    expect(zoneSplit('top')).toEqual({ axis: 'column', direction: 'before' })
+-    expect(zoneSplit('bottom')).toEqual({ axis: 'column', direction: 'after' })
+-  })
