+-    } as never)
+-    const registered: Array<ResourceProvider<'file'>> = []
+-    let released = 0
+-    ctx.provide('resources', {
+-      register: (provider: ResourceProvider<'file'>) => {
+-        registered.push(provider)
+-        return () => {
+-          released++
+-          controller.abort()
