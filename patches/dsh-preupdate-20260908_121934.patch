+-  return (
+-    <Menu
+-      open={open}
+-      align="end"
+-      dense
+-      selection="fill"
+-      onClose={() => { setOpen(false) }}
+-      items={items}
+-      selectedId={current}
+-      onSelect={(id) => {
+-        setOpen(false)
+-        // A pick while a launch is in flight is ignored whole: persisting the
+-        // choice without launching would leave the button naming an app the
+-        // gesture never opened.
+-        if (inFlight.current) return
+-        props.choose(id)
