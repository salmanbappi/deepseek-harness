+-  const configPath = join(root, 'cordis.yml')
+-  await writeFile(configPath, [
+-    "- name: '@deepseek-ai/dsh-host-webserver'",
+-    '  config:',
+-    "    host: '127.0.0.1'",
+-    '    port: 0',
+-    "- name: '@deepseek-ai/dsh-host-open-in-app'",
+-    '  config:',
+-    '    probeTimeoutMs: 5000',
+-    '    iconTimeoutMs: 5000',
+-    '    launchWatchMs: 1000',
+-    '',
