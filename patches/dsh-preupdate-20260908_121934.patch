+-      while (!this.closed) {
+-        const observed = this.queue.popFront()
+-        if (observed !== undefined) {
+-          yield observed
+-          continue
+-        }
+-        await new Promise<void>((resolve) => { this.wake = resolve })
+-        this.wake = undefined
+-      }
+-    } finally {
+-      signal.removeEventListener('abort', abort)
+-    }
+-  }
+-}
