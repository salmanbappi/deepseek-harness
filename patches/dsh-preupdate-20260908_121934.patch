+-  display: flex;
+-  flex: none;
+-  gap: 4px;
+-  align-items: center;
+-  height: 36px;
+-  padding: 0 6px;
+-  border-bottom: 0.5px solid var(--dsw-alias-border-l1);
+-  touch-action: none;
+-}
