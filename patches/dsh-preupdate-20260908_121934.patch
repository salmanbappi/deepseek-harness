+-/** Every intent as a spy, so a spec can assert exactly which one fired. */
+-function spyIntents(): DockIntents & Record<keyof DockIntents, ReturnType<typeof vi.fn>> {
+-  return {
+-    focusTab: vi.fn(),
+-    focusPane: vi.fn(),
+-    splitPane: vi.fn(),
