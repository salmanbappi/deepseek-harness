+-async function runWindows(
+-  host: FakeRunnerHost,
+-  native: SpawnRunnerInternals,
+-  start: unknown = { type: 'start', cwd: 'C:\\target', env: { TARGET: 'yes', dsh_subprocess_runner: 'restored' } },
+-  targetArgv: string[] = ['tool.exe', 'literal arg'],
