+const HEADER_NAME = /^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/u
+
+/** Header values travel on one line; CR, LF, or NUL cannot mean what the section wrote. */
+const UNENCODABLE_HEADER_VALUE = /[\0\r\n]/u
