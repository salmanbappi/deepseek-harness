-      }
-      group.chunks.push(event)
-      const chunk = record(data['chunk'])
-      if (chunk['type'] === 'finish') group.terminal = true
-      continue
-    }
-    if (event.type !== 'assistant/message') {
-      closeAttemptAtBoundary(event, current)
