-function generationPath(root: string, version: number, compression: JsonlCompression): string {
-  const suffix = compression === 'zstd' ? '.jsonl.zstd' : '.jsonl'
-  return join(root, version === 0 ? `session${suffix}` : `session.v${version}${suffix}`)
-}
