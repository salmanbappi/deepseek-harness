-    case 'session/title':
-    case 'session/title-llm-request':
-      return {
-        ...data,
-        messageSeqs: mapList(
-          numberArray(data['messageSeqs'] as SessionFormatJsonValue),
-          mapping,
-          `${event.type} ${event.seq} messageSeqs`,
