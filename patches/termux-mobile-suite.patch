-  format: JsonlGenerationFormatAdapter = adapter(),
-  sourceVersion = 0,
-): EnsureJsonlGenerationOptions {
-  return {
-    sourcePath: generationPath(root, sourceVersion, compression),
-    sourceVersion,
-    currentPath: generationPath(root, format.currentVersion, compression),
-    compression,
-    format,
-  }
-}
