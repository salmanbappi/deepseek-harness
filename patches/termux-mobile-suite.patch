-async function encodeZstd(version: number, rows: readonly unknown[]): Promise<Buffer> {
-  return Buffer.concat([
-    await compressZstdFrame(line(header(version))),
-    ...rows.length === 0
-      ? []
-      : [await compressZstdFrame(rows.map(row => line(row)).join(''))],
-  ])
-}
