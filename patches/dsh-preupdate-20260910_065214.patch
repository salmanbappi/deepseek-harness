+-
+-const MSG = 'm-1' as MessageId
+-
+-function bench(result: () => Promise<MessageFeedbackActionResult> = () => Promise.resolve({ ok: true })) {
+-  const submit = vi.fn<FeedbackSubmit>(() => result())
