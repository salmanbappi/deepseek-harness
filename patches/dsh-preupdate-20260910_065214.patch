+-  static instances: PendingIntersectionObserver[] = []
+-  readonly observed = new Set<Element>()
+-
+-  constructor(private readonly callback: IntersectionObserverCallback) {
+-    PendingIntersectionObserver.instances.push(this)
+-  }
