+-
+-/** One of the fixed feedback categories; the ids are durable log vocabulary. */
+-export type FeedbackCategory =
+-  | 'task-result'
+-  | 'instruction-following'
+-  | 'product-interaction'
+-  | 'service-stability'
+-  | 'resource-cost'
