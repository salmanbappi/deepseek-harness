+-  const collapsible = matched.presented.length > COLLAPSED_PRESENTED_COUNT
+-  const presented = collapsible && !expanded
+-    ? matched.presented.slice(0, COLLAPSED_PRESENTED_COUNT)
+-    : matched.presented
+-  useEffect(() => {
