+-    configurable: true,
+-    get(this: HTMLElement) {
+-      return this.parentElement?.classList.contains('md-code-block') === true
+-        && this.parentElement.firstElementChild === this ? CODE_TOOLBAR_HEIGHT : 0
+-    },
+-  })
+-})
