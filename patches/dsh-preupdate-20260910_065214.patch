+-   surfaces settle, one copy in ui-primitives could serve every pane header. */
+-.header {
+-  display: flex;
+-  flex: 0 0 auto;
+-  gap: 4px;
+-  align-items: center;
+-  box-sizing: border-box;
+-  height: 38px;
